#!/usr/bin/env python3
"""Save an article to the Kindle reading list.

    kindle-add <url> [--no-push]

Fetches the page, extracts clean article text, writes docs/a/<slug>.json,
rebuilds the static site, commits, and pushes. Live at neves.cloud/kindle
in ~1 min (GitHub Pages rebuild). That push-to-live latency IS the
"real-time" here -- no server to run.
"""
import html as htmlmod
import json
import os
import re
import subprocess
import sys
import unicodedata
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ADIR = os.path.join(ROOT, "docs", "a")


def ensure_trafilatura():
    try:
        import trafilatura  # noqa
    except ImportError:
        print("installing trafilatura (one-time)...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "trafilatura"])


def slugify(s):
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode()
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s).strip("-").lower()
    return (s or "article")[:60]


def md_inline(s):
    s = htmlmod.escape(s)
    s = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)",
               lambda m: '<img alt="%s" src="%s">' % (m.group(1), m.group(2)), s)
    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)",
               lambda m: '<a href="%s">%s</a>' % (m.group(2), m.group(1)), s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", s)
    s = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<i>\1</i>", s)
    return s


def md_to_html(md):
    """Minimal markdown -> clean reading HTML (paragraphs, headings, lists, links)."""
    out = []
    for block in re.split(r"\n\s*\n", md.strip()):
        block = block.strip()
        if not block:
            continue
        h = re.match(r"^(#{1,6})\s+(.*)", block)
        if h:
            lvl = min(len(h.group(1)) + 1, 4)  # shift down: page already has the <h1>
            out.append("<h%d>%s</h%d>" % (lvl, md_inline(h.group(2)), lvl))
            continue
        lines = block.split("\n")
        if all(re.match(r"^[-*]\s+", ln) for ln in lines):
            items = "".join("<li>%s</li>" % md_inline(re.sub(r"^[-*]\s+", "", ln)) for ln in lines)
            out.append("<ul>%s</ul>" % items)
            continue
        out.append("<p>%s</p>" % md_inline(" ".join(lines)))
    return "".join(out)


def main():
    args = [a for a in sys.argv[1:] if a != "--no-push"]
    push = "--no-push" not in sys.argv[1:]
    if not args:
        sys.exit("usage: kindle-add <url> [--no-push]")
    url = args[0]

    ensure_trafilatura()
    import trafilatura

    downloaded = trafilatura.fetch_url(url)
    if not downloaded:
        sys.exit("could not fetch: " + url)

    # extract as markdown (drops nav/ads/boilerplate), then -> clean reading HTML
    md = trafilatura.extract(
        downloaded, output_format="markdown",
        include_links=True, include_images=True, include_comments=False,
    )
    if not md:
        sys.exit("could not extract article text from: " + url)
    body_html = md_to_html(md)
    meta = trafilatura.extract_metadata(downloaded)
    title = (meta.title if meta and meta.title else url).strip()
    site = (meta.sitename if meta and meta.sitename else re.sub(r"^https?://(www\.)?", "", url).split("/")[0])

    added = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    slug = slugify(title) + "-" + added[5:10].replace("-", "")  # title + MMDD, keeps it unique-ish

    os.makedirs(ADIR, exist_ok=True)
    path = os.path.join(ADIR, slug + ".json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump({"title": title, "url": url, "site": site,
                   "added": added, "html": body_html}, f, ensure_ascii=False, indent=0)
    print("saved: %s  (%s)" % (title, slug))

    subprocess.check_call([sys.executable, os.path.join(ROOT, "build.py")])

    if push:
        subprocess.check_call(["git", "-C", ROOT, "add", "-A"])
        subprocess.check_call(["git", "-C", ROOT, "commit", "-q", "-m", "add: " + title])
        subprocess.check_call(["git", "-C", ROOT, "push", "-q"])
        print("pushed -> live at neves.cloud/kindle in ~1 min")
    else:
        print("built locally (not pushed)")


if __name__ == "__main__":
    main()
