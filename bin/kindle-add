#!/usr/bin/env python3
"""Save an article to the Kindle reading list.

    kindle-add <url> [--no-push]                       # fetch + extract a web page
    kindle-add --stdin --title T [--site S] [--no-push] # pipe markdown in
    kindle-add --md FILE [--title T] [--site S] [--no-push]

The URL form fetches and extracts a page; the text forms take markdown you
already have (a session answer, a draft) and skip the fetch. All three write
docs/a/<slug>.json, rebuild the static site, commit, and push. Live at
neves.cloud/kindle in ~1 min (GitHub Pages rebuild). That push-to-live latency
IS the "real-time" here -- no server to run.
"""
import html as htmlmod
import json
import os
import re
import subprocess
import sys
import unicodedata
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ADIR = os.path.join(ROOT, "docs", "a")


def ensure_trafilatura():
    try:
        import trafilatura  # noqa
    except ImportError:
        print("installing trafilatura (one-time)...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", "-q", "trafilatura"])


def slugify(s):
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode()
    s = re.sub(r"[^a-zA-Z0-9]+", "-", s).strip("-").lower()
    return (s or "article")[:60]


def md_inline(s):
    s = htmlmod.escape(s)
    s = re.sub(r"!\[([^\]]*)\]\(([^)]+)\)",
               lambda m: '<img alt="%s" src="%s">' % (m.group(1), m.group(2)), s)
    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)",
               lambda m: '<a href="%s">%s</a>' % (m.group(2), m.group(1)), s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<b>\1</b>", s)
    s = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<i>\1</i>", s)
    return s


def md_to_html(md):
    """Minimal markdown -> clean reading HTML (paragraphs, headings, lists, links)."""
    out = []
    for block in re.split(r"\n\s*\n", md.strip()):
        block = block.strip()
        if not block:
            continue
        h = re.match(r"^(#{1,6})\s+(.*)", block)
        if h:
            lvl = min(len(h.group(1)) + 1, 4)  # shift down: page already has the <h1>
            out.append("<h%d>%s</h%d>" % (lvl, md_inline(h.group(2)), lvl))
            continue
        lines = block.split("\n")
        if all(re.match(r"^[-*]\s+", ln) for ln in lines):
            items = "".join("<li>%s</li>" % md_inline(re.sub(r"^[-*]\s+", "", ln)) for ln in lines)
            out.append("<ul>%s</ul>" % items)
            continue
        out.append("<p>%s</p>" % md_inline(" ".join(lines)))
    return "".join(out)


def opt(args, name):
    """Pop --name VALUE out of args, returning VALUE (or None)."""
    if name in args:
        i = args.index(name)
        val = args[i + 1] if i + 1 < len(args) else None
        del args[i:i + 2]
        return val
    return None


def from_url(url):
    """Fetch + extract a web page -> (title, url, site, body_html)."""
    ensure_trafilatura()
    import trafilatura

    downloaded = trafilatura.fetch_url(url)
    if not downloaded:
        sys.exit("could not fetch: " + url)
    # extract as markdown (drops nav/ads/boilerplate), then -> clean reading HTML
    md = trafilatura.extract(
        downloaded, output_format="markdown",
        include_links=True, include_images=True, include_comments=False,
    )
    if not md:
        sys.exit("could not extract article text from: " + url)
    meta = trafilatura.extract_metadata(downloaded)
    title = (meta.title if meta and meta.title else url).strip()
    site = (meta.sitename if meta and meta.sitename else re.sub(r"^https?://(www\.)?", "", url).split("/")[0])
    return title, url, site, md_to_html(md)


def from_md(md, title, site, fallback="untitled note"):
    """Markdown you already have -> (title, url, site, body_html).

    Title precedence: explicit `title` > the document's leading '# H1' > fallback.
    The saved page has no source URL.
    """
    md = md.strip()
    if not md:
        sys.exit("no text given")
    # a leading '# H1' becomes the page title (which build.py renders) -- so when
    # we adopt it, drop it from the body to avoid repeating it as a heading.
    h1 = re.match(r"^#\s+(.*)\n?", md)
    if h1 and not title:
        title = h1.group(1).strip()
        md = md[h1.end():].strip()
    return title or fallback, "", site or "session", md_to_html(md or "_(empty)_")


def publish(title, url, site, body_html, push):
    added = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    slug = slugify(title) + "-" + added[5:10].replace("-", "")  # title + MMDD, keeps it unique-ish

    os.makedirs(ADIR, exist_ok=True)
    path = os.path.join(ADIR, slug + ".json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump({"title": title, "url": url, "site": site,
                   "added": added, "html": body_html}, f, ensure_ascii=False, indent=0)
    print("saved: %s  (%s)" % (title, slug))

    subprocess.check_call([sys.executable, os.path.join(ROOT, "build.py")])

    if push:
        subprocess.check_call(["git", "-C", ROOT, "add", "-A"])
        subprocess.check_call(["git", "-C", ROOT, "commit", "-q", "-m", "add: " + title])
        subprocess.check_call(["git", "-C", ROOT, "push", "-q"])
        print("pushed -> live at neves.cloud/kindle in ~1 min")
    else:
        print("built locally (not pushed)")


def main():
    args = sys.argv[1:]
    push = "--no-push" not in args
    args = [a for a in args if a != "--no-push"]

    use_stdin = "--stdin" in args
    if use_stdin:
        args.remove("--stdin")
    title = opt(args, "--title")
    site = opt(args, "--site")
    md_file = opt(args, "--md")

    if use_stdin:
        title, url, site, body_html = from_md(sys.stdin.read(), title, site)
    elif md_file:
        with open(md_file, encoding="utf-8") as f:
            md = f.read()
        stem = os.path.splitext(os.path.basename(md_file))[0]
        title, url, site, body_html = from_md(md, title, site, fallback=stem)
    elif args:
        title, url, site, body_html = from_url(args[0])
    else:
        sys.exit("usage: kindle-add <url> | --stdin --title T | --md FILE  [--site S] [--no-push]")

    publish(title, url, site, body_html, push)


if __name__ == "__main__":
    main()
